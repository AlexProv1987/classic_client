{
    "Person Layout Boilerplate": {
        "prefix": "personlayout",
        "body": [
            "import { Alert, Col, Container, Row } from 'react-bootstrap';",
            "",
            "export const ${1:PersonLayout} = () => {",
            "  const [alert, setAlert] = useState(null);",
            "",
            "  return (",
            "    <Container fluid>",
            "      <Row className='mt-2'>",
            "        {alert && (",
            "          <Alert",
            "            key={alert.id}",
            "            dismissible",
            "            variant={alert.variant}",
            "            style={{",
            "              position: 'absolute',",
            "              top: 0, left: 0, right: 0,",
            "              zIndex: 10, borderRadius: 0",
            "            }}",
            "          >",
            "            {alert.message}",
            "          </Alert>",
            "        )}",
            "",
            "        <Col md={6}>",
            "          <p>hi col 1</p>",
            "        </Col>",
            "        <Col xs={6}>",
            "          <div><p>hi col 2</p></div>",
            "        </Col>",
            "      </Row>",
            "    </Container>",
            "  );",
            "};"
        ],
        "description": "Layout with Alert and two Cols"
    }
}